# Variables publiques Next.js (injectées au build via ARG). Aucune valeur secrète ici.
# Copier en .env.local pour le dev (fichier ignoré par git).
NEXT_PUBLIC_API_URL=http://localhost:8090/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:8081
NEXT_PUBLIC_STORAGE_URL=http://localhost:9000
NEXT_PUBLIC_WOC_URL=http://localhost:3000
# Clé publique Stripe (pk_test_xxx) — nécessaire pour les dons aux mentors.
# À définir dans frontend/.env.local (ignoré par git). Vide = fonctionnalité désactivée côté front.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
