FROM php:8.4-cli

# 1. Installer les libs nécessaires + extensions PHP
RUN apt-get update && apt-get install -y \
    unzip git curl libzip-dev libicu-dev libonig-dev libmariadb-dev \
    && docker-php-ext-install pdo pdo_mysql intl zip \
    && rm -rf /var/lib/apt/lists/*

# 2. Installer Composer
RUN curl -sS https://getcomposer.org/installer | php -- --install-dir=/usr/local/bin --filename=composer

WORKDIR /app

COPY . .

# .env requis par le runtime Symfony (bootEnv) — non tracké dans git depuis SEC-1.
RUN cp .env.example .env

# 3. Installer toutes les dépendances (y compris dev)
RUN composer install --no-interaction --prefer-dist

CMD ["php", "bin/console", "doctrine:fixtures:load", "--no-interaction", "--env=dev"]
