###> symfony/framework-bundle ###
APP_ENV=dev
# Générer une valeur unique par environnement : openssl rand -hex 16
APP_SECRET=changeme_use_openssl_rand_hex_16
###< symfony/framework-bundle ###

DATABASE_URL="mysql://application:password@db:3306/projet_web"

# Sel pour hasher les adresses IP (RGPD)
IP_HASH_SALT=changeme_in_production_use_a_random_256bit_value

# Lock DSN
LOCK_DSN=flock

# CORS
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=""
### Laisser JWT_PASSPHRASE vide, pour le mode dev, en prod il faudra recréer des clés avec une passphrase pour une mise en prod propre
###< lexik/jwt-authentication-bundle ###

###> Secrets applicatifs — valeurs réelles via Vault (prod) ou .env.local (dev), JAMAIS ici ###
# Mailer, ex : gmail+smtp://user:app_password@default
MAILER_DSN=
# Secret partagé backend <-> messagerie (SEC-14) : openssl rand -hex 32
INTERNAL_SECRET=
# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# URLs de retour après onboarding mentor (pointer vers le frontend)
STRIPE_CONNECT_RETURN_URL=http://localhost:3000/mentor/onboarding/complete
STRIPE_CONNECT_REFRESH_URL=http://localhost:3000/mentor/onboarding
# Commission plateforme (ex: 0.12 = 12%). Vérifier les frais Stripe sur stripe.com/pricing.
STRIPE_PLATFORM_FEE_RATE=0.12
# Frais Stripe estimés pour votre région — à ajuster selon stripe.com/pricing
STRIPE_FEE_RATE=0.015
STRIPE_FEE_FIXED_CENTS=25

# Services tiers
MESSAGERIE_URL=http://messagerie:3000
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=woc
MINIO_PUBLIC_URL=http://localhost:9000/woc
ELASTICSEARCH_HOST=http://elasticsearch:9200
###< Secrets applicatifs ###
# Trigger CI pipeline
