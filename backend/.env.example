###> symfony/framework-bundle ###
APP_ENV=dev
# Générer une valeur unique par environnement : openssl rand -hex 16
APP_SECRET=changeme_use_openssl_rand_hex_16
###< symfony/framework-bundle ###

DATABASE_URL="mysql://application:password@db:3306/quest_web"

# Sel pour hasher les adresses IP (RGPD)
IP_HASH_SALT=changeme_in_production_use_a_random_256bit_value


###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=""
### Laisser JWT_PASSPHRASE vide, pour le mode dev, en prod il faudra recréer des clés avec une passphrase pour une mise en prod propre
###< lexik/jwt-authentication-bundle ###

###> Secrets applicatifs — valeurs réelles via Vault (prod) ou .env.local (dev), JAMAIS ici ###
# Mailer, ex : gmail+smtp://user:app_password@default
MAILER_DSN=
# Secret partagé backend <-> messagerie (SEC-14) : openssl rand -hex 32
INTERNAL_SECRET=
# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
###< Secrets applicatifs ###
