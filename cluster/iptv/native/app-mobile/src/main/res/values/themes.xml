<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PurpleIPTV" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="mediaRouteTheme">@style/CustomMediaRouteTheme</item>
        <!-- Set default cast button tint to white -->
        <item name="mediaRouteButtonTint">#FFFFFF</item>
    </style>

    <style name="CustomMediaRouteTheme" parent="Theme.MediaRouter">
        <!-- Dialog global background -->
        <item name="android:windowBackground">@drawable/cast_dialog_bg</item>
        <!-- The title color (e.g. "Sélectionner un appareil") -->
        <item name="android:textColorPrimary">#FFFFFF</item>
        <!-- The subtitle color (device list items) -->
        <item name="android:textColorSecondary">#A0A0A0</item>
        <item name="colorPrimary">#A855F7</item>
    </style>
</resources>
