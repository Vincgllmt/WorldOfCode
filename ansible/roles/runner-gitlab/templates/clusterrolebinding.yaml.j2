apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: {{ runner_clusterrolebinding_name }}
subjects:
  - kind: ServiceAccount
    name: default
    namespace: {{ runner_namespace }}
roleRef:
  kind: ClusterRole
  name: cluster-admin
  apiGroup: rbac.authorization.k8s.io

